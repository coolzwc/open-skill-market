---
import ContentLayout from "@/layouts/ContentLayout.astro";
import { getLang, MESSAGES, type Lang } from "@/lib/i18n";

export const prerender = true;

export async function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "zh" } }];
}

const lang = getLang(Astro.params.lang) as Lang;
const t = MESSAGES[lang];

const CONTACT_EMAIL = "coolzwc@gmail.com";
const REPO_URL = "https://github.com/coolzwc/open-skill-market";
const ISSUES_URL = `${REPO_URL}/issues`;

const channels = [
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`,
    label: t.contactEmail,
    desc: t.contactEmailDesc
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.694.825.576C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12"/></svg>`,
    label: t.contactGithub,
    desc: t.contactGithubDesc
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>`,
    label: t.contactIssues,
    desc: t.contactIssuesDesc
  }
];
---

<ContentLayout
  lang={lang}
  slug="contact"
  title={`${t.contactTitle} | ${t.siteName}`}
  description={t.contactDesc}
>
  <!-- Page title -->
  <div class="page-hero animate-in">
    <div class="page-hero-icon">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    </div>
    <h1>{t.contactTitle}</h1>
    <p class="page-intro">{t.contactIntro}</p>
  </div>

  <!-- Email card (primary channel) -->
  <section class="page-section animate-in delay-1">
    <div class="email-card">
      <div class="email-card-head">
        <span class="email-label">{t.contactEmail}</span>
        <span class="email-badge">{lang === "zh" ? "推荐" : "Recommended"}</span>
      </div>
      <div class="email-row">
        <a class="email-address" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
        <button
          class="copy-btn"
          id="copy-email"
          type="button"
          data-email={CONTACT_EMAIL}
          data-copy-label={t.copyCommand}
          data-copied-label={t.copied}
          aria-label={t.copyCommand}
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          <span id="copy-email-text">{t.copyCommand}</span>
        </button>
      </div>
      <p class="email-desc">{t.contactEmailDesc}</p>
    </div>
    <script>
      const copyBtn = document.getElementById("copy-email");
      const copyText = document.getElementById("copy-email-text");
      const copiedLabel = copyBtn?.dataset.copiedLabel;
      copyBtn?.addEventListener("click", async () => {
        const email = copyBtn.dataset.email || "";
        try {
          await navigator.clipboard.writeText(email);
          if (copyText) {
            copyText.textContent = copiedLabel || "Copied!";
            setTimeout(() => {
              copyText.textContent = copyBtn.dataset.copyLabel || "Copy";
            }, 1600);
          }
        } catch {
          window.location.href = `mailto:${email}`;
        }
      });
    </script>
  </section>

  <!-- Other channels -->
  <section class="page-section animate-in delay-2">
    <h2 class="page-section-title">{lang === "zh" ? "其他渠道" : "Other Channels"}</h2>
    <div class="channel-grid">
      {channels.slice(1).map((c) => (
        <div class="channel-card">
          <div class="channel-icon" set:html={c.icon} />
          <h3>{c.label}</h3>
          <p>{c.desc}</p>
        </div>
      ))}
    </div>
    <div class="cta-row">
      <a class="cta-btn" href={ISSUES_URL} target="_blank" rel="noreferrer">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        {t.contactIssues}
      </a>
      <a class="cta-btn ghost" href={REPO_URL} target="_blank" rel="noreferrer">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.694.825.576C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12"/></svg>
        {t.contactGithub}
      </a>
    </div>
  </section>

  <!-- Response time -->
  <section class="page-section animate-in delay-3">
    <h2 class="page-section-title">{t.contactResponse}</h2>
    <p class="page-text">{t.contactResponseDesc}</p>
  </section>

  <!-- About link -->
  <section class="page-section animate-in delay-4">
    <a class="cta-btn ghost" href={`/${lang}/about/`}>{t.navAbout}</a>
  </section>
</ContentLayout>

<style>
  /* ---- Hero ---- */
  .page-hero {
    margin-bottom: 2.5rem;
  }

  .page-hero-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(110,231,183,0.12), rgba(103,232,249,0.08));
    border: 1px solid rgba(110,231,183,0.15);
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .page-hero h1 {
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    font-weight: 700;
    line-height: 1.2;
    background: linear-gradient(135deg, var(--accent), var(--cyan));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.75rem;
  }

  .page-intro {
    color: var(--text-soft);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 60ch;
  }

  /* ---- Section ---- */
  .page-section {
    margin-bottom: 2.25rem;
  }

  .page-section-title {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-bottom: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .page-section-title::before {
    content: "";
    display: inline-block;
    width: 12px;
    height: 2px;
    background: var(--accent);
    border-radius: 1px;
  }

  .page-text {
    color: var(--text-soft);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  /* ---- Email card ---- */
  .email-card {
    position: relative;
    padding: 1.35rem 1.25rem;
    border: 1px solid var(--line-bright);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    overflow: hidden;
  }

  .email-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), var(--cyan), transparent);
  }

  .email-card-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.75rem;
  }

  .email-label {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-dim);
  }

  .email-badge {
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.62rem;
    font-weight: 500;
    color: var(--accent);
    background: var(--accent-dim);
    border: 1px solid rgba(110,231,183,0.15);
  }

  .email-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .email-address {
    font-family: "JetBrains Mono", monospace;
    font-size: clamp(1rem, 3.2vw, 1.35rem);
    font-weight: 600;
    color: var(--accent);
    user-select: all;
    transition: opacity 160ms ease;
  }

  .email-address:hover {
    opacity: 0.82;
  }

  .email-desc {
    margin-top: 0.6rem;
    font-size: 0.8rem;
    color: var(--text-dim);
    line-height: 1.5;
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.7rem;
    border-radius: 7px;
    border: 1px solid var(--line-bright);
    background: rgba(255,255,255,0.02);
    color: var(--text-soft);
    font-family: inherit;
    font-size: 0.78rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 170ms ease;
  }

  .copy-btn:hover {
    color: var(--accent);
    border-color: rgba(110,231,183,0.4);
    background: rgba(110,231,183,0.06);
  }

  /* ---- Channel cards ---- */
  .channel-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem;
  }

  .channel-card {
    padding: 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-card);
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .channel-card:hover {
    border-color: var(--line-bright);
    background: var(--bg-card-hover);
    transform: translateY(-2px);
  }

  .channel-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 9px;
    background: rgba(103,232,249,0.08);
    border: 1px solid rgba(103,232,249,0.12);
    color: var(--cyan);
    margin-bottom: 0.65rem;
  }

  .channel-card h3 {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.3rem;
  }

  .channel-card p {
    font-size: 0.82rem;
    color: var(--text-dim);
    line-height: 1.55;
  }

  /* ---- CTA ---- */
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.9rem;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--accent);
    border: 1px solid rgba(110,231,183,0.25);
    background: rgba(110,231,183,0.06);
    transition: all 180ms ease;
  }

  .cta-btn:hover {
    background: rgba(110,231,183,0.14);
    border-color: rgba(110,231,183,0.45);
    transform: translateY(-1px);
  }

  .cta-btn.ghost {
    color: var(--text-soft);
    border-color: var(--line-bright);
    background: transparent;
  }

  .cta-btn.ghost:hover {
    color: var(--text);
    background: rgba(255,255,255,0.04);
  }

  @media (max-width: 600px) {
    .channel-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
